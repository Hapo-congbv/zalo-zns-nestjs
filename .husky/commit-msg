npx --no -- commitlint --edit "$1" || {
  echo ""
  echo "❌ Invalid commit message format!"
  echo ""
  echo "📝 Required format: <type>: <subject>"
  echo ""
  echo "✅ Valid types:"
  echo "   - feat:     New feature"
  echo "   - fix:      Bug fix"
  echo "   - hot_fix:  Hot fix (urgent bug fix)"
  echo "   - docs:     Documentation"
  echo "   - style:    Code style"
  echo "   - refactor: Code refactoring"
  echo "   - perf:     Performance improvement"
  echo "   - test:     Tests"
  echo "   - build:    Build system"
  echo "   - ci:       CI/CD"
  echo "   - chore:    Chores"
  echo "   - revert:   Revert commit"
  echo ""
  echo "✅ Examples:"
  echo "   git commit -m \"feat: add new feature\""
  echo "   git commit -m \"fix: resolve timeout issue\""
  echo "   git commit -m \"hot_fix: fix critical bug\""
  echo ""
  echo "❌ Invalid examples:"
  echo "   git commit -m \"fix 123123123\"        # Missing :"
  echo "   git commit -m \"add feature\"          # Missing type"
  echo "   git commit -m \"F123123123\"           # Invalid format"
  echo ""
  exit 1
}
